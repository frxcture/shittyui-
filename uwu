	function tbl2:LoadConfig(arg2)
		local v1 = FolderPath .. "/" .. arg2

		if not isfile(v1) then
			warn("[Hawk Lib]: Config file not found.")
			return
		end

		local v2 = readfile(v1)
		local ok, result = pcall(HttpService.JSONDecode, HttpService, v2)

		if not ok then
			warn("[Hawk Lib]: Failed to decode config.")
			return
		end

		for _, v3 in pairs(result) do
			local flag = v3.flag
			if tbl.Elements[flag] then
				if v3.type == "Slider" then
					tbl.Elements[flag]:SetValue(v3.value)
				elseif v3.type == "Dropdown" then
					local tbl1 = {}

					for k, v4 in pairs(v3.selected) do
						if v4 == true then
							table.insert(tbl1, k)
						end
					end

					tbl.Elements[flag]:Select(tbl1)
				elseif v3.type == "Picker" then
					local tbl2 = {}

					for _, v5 in pairs(v3.selected) do
						table.insert(tbl2, v5)
					end

					tbl.Elements[flag]:Select(tbl2)
				elseif v3.type == "CheckBox" then
					tbl.Elements[flag]:SetStatus(v3.status)
				elseif v3.type == "Toggle" then
					tbl.Elements[flag]:SetStatus(v3.status)
				elseif v3.type == "KeyBind" then
					tbl.Elements[flag]:SetKey(v3.key)
				elseif v3.type == "TextBox" then
					tbl.Elements[flag]:SetText(v3.text)
				elseif v3.type == "ColorPicker" then
					local v6, v7, v8 = string.match(v3.color, "([^,]+),%s*([^,]+),%s*([^,]+)")
					if v6 and v7 and v8 then
						local color3 = Color3.new(tonumber(v6), tonumber(v7), tonumber(v8))
						tbl.Elements[flag]:SetColor(color3)
					end
				end
			end
		end
	end

