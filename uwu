local function func(arg1, arg2, arg3)
	local flag = false
	local Position
	local Position1

	arg3.InputBegan:Connect(function(input)
		if flag1 then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			flag = true
			Position = input.Position
			Position1 = arg2.Position
		end
	end)

	arg3.InputEnded:Connect(function(input)
		if flag1 then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			flag = false
			Position = nil
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if flag1 then
			return
		end
		if flag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local v1 = input.Position.X - Position.X
			local v2 = input.Position.Y - Position.Y
			local v3 = Position1.X.Offset + v1
			local v4 = Position1.Y.Offset + v2
			local AbsoluteSize = arg1.AbsoluteSize
			local AbsoluteSize1 = arg2.AbsoluteSize
			local AnchorPoint = arg2.AnchorPoint
			local v5 = AnchorPoint.X * AbsoluteSize1.X
			local v6 = AbsoluteSize.X - AbsoluteSize1.X * (1 - AnchorPoint.X)
			local v7 = AnchorPoint.Y * AbsoluteSize1.Y
			local v8 = AbsoluteSize.Y - AbsoluteSize1.Y * (1 - AnchorPoint.Y)
			local v9 = v5 - AbsoluteSize.X * Position1.X.Scale
			local v10 = v6 - AbsoluteSize.X * Position1.X.Scale
			local v11 = v7 - AbsoluteSize.Y * Position1.Y.Scale
			local v12 = v8 - AbsoluteSize.Y * Position1.Y.Scale
			local v13 = math.clamp(v3, v9, v10)
			local v14 = math.clamp(v4, v11, v12)
			local uDim2 = UDim2.new(Position1.X.Scale, v13, Position1.Y.Scale, v14)
			TweenService:Create(arg2, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = uDim2}):Play()
		end
	end)
end

